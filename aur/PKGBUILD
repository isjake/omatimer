# Maintainer: Jake Ayala <jakeayala@gmail.com>
pkgname=omatimer-git
_name=omatimer
pkgver=1.1.0.r8.g63d01b4
pkgrel=1
pkgdesc="Small native Qt countdown timer for Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/isjake/omatimer"
license=('MIT' 'GPL-2.0-or-later' 'GPL-2.0-only' 'LGPL-2.0-or-later' 'CC-BY-SA-3.0' 'CC-BY-3.0' 'CC-BY-4.0') # MIT for the app; the rest for the bundled sounds
depends=('qt6-base' 'fontconfig')
makedepends=('git')
optdepends=('pipewire: timer sounds (pw-play)'
            'libpulse: timer sounds (paplay)')
provides=("$_name")
conflicts=("$_name")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_name"
    if git describe --tags >/dev/null 2>&1; then
        git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

build() {
    cd "$_name"
    qmake6 "$_name.pro" -o Makefile
    make
}

package() {
    cd "$_name"
    install -Dm755 "$_name" "$pkgdir/usr/bin/$_name"
    install -Dm644 "data/$_name.desktop" "$pkgdir/usr/share/applications/$_name.desktop"
    install -Dm644 "data/$_name.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_name.svg"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_name/LICENSE"
    install -Dm644 sounds/freedesktop/CREDITS "$pkgdir/usr/share/licenses/$_name/SOUNDS-CREDITS"
    install -d "$pkgdir/usr/share/$_name/sounds/freedesktop"
    install -m644 sounds/freedesktop/* "$pkgdir/usr/share/$_name/sounds/freedesktop/"
}
